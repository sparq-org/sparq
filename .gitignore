#   reports/  EARL + HTML + server.log for a run (the authoritative score lives here, not in markdown)
#   .cache/   shallow clone of solid-contrib/specification-tests
#   tls/*.pem the self-signed loopback pair generated from the committed tls/san.cnf, so no
#             long-lived private-key material enters the repo
/crates/sparq-lws-core/conformance/reports/
/crates/sparq-lws-core/conformance/.cache/
/crates/sparq-lws-core/conformance/tls/*.pem
