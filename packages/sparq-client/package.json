{
  "name": "@sparq/client",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic TypeScript client for the sparq WASM engine — re-exports the wasm-pack-generated Store surface plus loaders/query helpers, consumed by the Next.js site and the (proposed) Tauri 2 GUI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wasm-store": {
      "types": "./src/generated/sparq_wasm.d.ts",
      "default": "./src/generated/sparq_wasm.d.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-test-deps.mjs",
    "test": "node --import ./test-support/register-ts.mjs --test test/*.test.mjs",
    "check:wasm-types": "node scripts/check-wasm-types.mjs",
    "sync:wasm-types": "node scripts/sync-wasm-types.mjs",
    "build": "tsc"
  },
  "keywords": [
    "rdf",
    "sparql",
    "wasm",
    "webassembly",
    "triplestore"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "fzstd": "^0.1.1",
    "seek-bzip": "^2.0.0"
  }
}
