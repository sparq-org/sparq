rker while implementing #5425. Out-of-scope for that PR; captured as follow-up.\n<!-- sparq-followup:v1 -->","closed_by":null,"reactions":{"url":"https://api.github.com/repos/sparq-org/sparq/issues/6335/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sparq-org/sparq/issues/6335/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}