  "capacity_cases": [
    {
      "id": "constructed-year-capacity-1",
      "basis": "Implementation capacity, not a normative result golden",
      "dataset_ntriples": "",
      "query": "PREFIX xsd:<http://www.w3.org/2001/XMLSchema#> SELECT (STR(xsd:dateTime(CONCAT(\" 1000000001\", \"-01-01T00:00:00Z \"))) AS ?v) {}",
      "expected_error": "query evaluation capacity exceeded (temporal-year)"
    },
    {
      "id": "constructed-year-capacity-2",
