      "id": "raw-space-literal",
      "basis": "SPARQL 1.1 with strict RDF typed lexical validation",
      "dataset_ntriples": "",
      "query": "PREFIX xsd:<http://www.w3.org/2001/XMLSchema#> SELECT (\" 2024-02-29T12:34:56.123456789Z \"^^xsd:dateTime = \"2024-02-29T12:34:56.123456789Z\"^^xsd:dateTime AS ?v) {  }",
      "expected_rows": [
        [
          null
        ]
      ]
    },
    {
