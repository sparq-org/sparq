# One attestation bundle, attributed to the enumerated issuer and covered by a
# positive status attestation whose window contains t (design D3: "unrevoked" is
# the EXISTENCE of a covering window, never evidence of absence).
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix trustx: <https://sparq.dev/ns/trust#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<urn:bundle:age> prov:wasAttributedTo <did:web:dvla.example> ;
    trustx:coveredBy <urn:status:age> .

<urn:status:age> a trustx:StatusAttestation ;
    trustx:validFrom  "2026-07-01T00:00:00Z"^^xsd:dateTime ;
    trustx:validUntil "2026-07-10T00:00:00Z"^^xsd:dateTime .

GRAPH <urn:bundle:age> {
    <urn:person:jesse> foaf:age 25 .
}
