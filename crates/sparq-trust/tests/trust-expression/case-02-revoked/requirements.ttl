# Design §6 case 2 — identical trust requirements to case 1. Only the holder's
# status stratum differs, so the rejection is attributable to revocation alone.
@prefix trustx: <https://sparq.dev/ns/trust#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<urn:tr:revoked> a trustx:TrustRequirements ;
    trustx:question              <urn:question:jesse-has-an-age> ;
    trustx:trustsIssuer          <did:web:dvla.example> ;
    trustx:requiresValidStatusAt "2026-07-05T00:00:00Z"^^xsd:dateTime .
