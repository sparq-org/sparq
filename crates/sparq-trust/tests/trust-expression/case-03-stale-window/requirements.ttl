# Design §6 case 3 — identical trust requirements to case 1; only the attestation's
# validity window moves, so the rejection is attributable to staleness alone.
@prefix trustx: <https://sparq.dev/ns/trust#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<urn:tr:stale-window> a trustx:TrustRequirements ;
    trustx:question              <urn:question:jesse-has-an-age> ;
    trustx:trustsIssuer          <did:web:dvla.example> ;
    trustx:requiresValidStatusAt "2026-07-05T00:00:00Z"^^xsd:dateTime .
