# Shared ancestry rules: the transitive closure of the Solid slash-semantics parent.
# Prepended to every stratum of both systems (wac.n3, acp-a/b/c.n3).
#
# Input facts (loader-synthesized, see src/loader.rs):
#   <R> solidx:isResource true .   — every pod graph + every structural container prefix
#   <R> solidx:parent <P> .        — immediate parent (loader::parent_iri), kept only when
#                                    <P> is a resource too, so the walk stops at the pod root
# Outputs (consumed by wac.n3 nearest-ancestor walk / acp-a.n3 cumulative inheritance):
#   <R> solidx:ancestor <A> .      — transitive closure of parent

@prefix solidx: <https://sparq.dev/ns/solidx#> .

{ ?r solidx:parent ?p . }                          => { ?r solidx:ancestor ?p } .
{ ?r solidx:parent ?p . ?p solidx:ancestor ?a . }  => { ?r solidx:ancestor ?a } .
