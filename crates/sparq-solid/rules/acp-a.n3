# ACP (https://solidproject.org/TR/acp) — STRATUM A (monotone + input-only negation):
# effective policies, matcher accept-sets over the principal lattice, candidate
# (agent, client, issuer) triples. Strata B/C (separate reason_n3 calls) add the NAF
# layers; see research/solid-access-control-design.md §3.4–3.5.
#
# Principal lattice: auth:Public ⊒ auth:Authenticated ⊒ concrete WebID;
# auth:AnyClient ⊒ concrete client id; auth:AnyIssuer ⊒ concrete issuer (OIDC IdP).
# [OPUS-4.8] sq-3jtd.6: the issuer dimension is the exact twin of the client dimension
# (design doc §3.6 — "acp:issuer is the same shape as acp:client"). A matcher "accepts" a
# principal iff it accepts EVERY context the principal denotes, so surviving candidates
# are sound grants.
#
# Loader-synthesized inputs (besides common.n3's): <R> solidx:ownAcr <R.acr> ;
# <A> solidx:isWebId true for concrete agent IRIs seen in ACR/group docs;
# [SONNET-4.6] sq-ysv3u <A> solidx:holdsVc <C> for each ALREADY-VERIFIED credential
# requirement <C> the caller asserts agent <A> satisfies (the acp:vc trusted channel).
#
# Outputs (stratum B's inputs): ?pol solidx:appliesToResource ?r (ACP §"Effective
# Policies": own accessControl + cumulative ancestor memberAccessControl);
# ?m solidx:acceptsAgentP/acceptsClientP/acceptsIssuerP ?p (matcher accept-sets, ACP
# §"Matchers"); ?pol solidx:candTriple ?k with solidx:pairAgent/pairClient/pairIssuer
# (candidate principals).

@prefix acp:    <http://www.w3.org/ns/solid/acp#> .
@prefix auth:   <https://sparq.dev/ns/auth#> .
@prefix solidx: <https://sparq.dev/ns/solidx#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix log:    <http://www.w3.org/2000/10/swap/log#> .

# ── effective policies: own ACR + CUMULATIVE member access control of ALL ancestors ───
{ ?r solidx:ownAcr ?acr . ?acr acp:accessControl ?c . ?c acp:apply ?pol . }
=> { ?pol solidx:appliesToResource ?r . } .
{ ?r solidx:ancestor ?anc . ?anc solidx:ownAcr ?acr .
  ?acr acp:memberAccessControl ?c . ?c acp:apply ?pol . }
=> { ?pol solidx:appliesToResource ?r . } .

# ── matcher registry (noneOf matchers get accept-sets but generate NO candidates) ─────
{ ?pol acp:allOf ?m . }  => { ?pol solidx:hasMatcher ?m . ?m solidx:isMatcher true . } .
{ ?pol acp:anyOf ?m . }  => { ?pol solidx:hasMatcher ?m . ?m solidx:isMatcher true . } .
{ ?pol acp:noneOf ?m . } => { ?m solidx:isMatcher true . } .

# [GPT-6] ACP §6.5 requires at least one attribute. Absent dimensions are
# unconstrained only for a nonempty matcher; rdf:type alone is not an attribute.
# Keep this guard shared by positive matchers and noneOf exception accept-sets.
{ ?m solidx:isMatcher true . ?m acp:agent ?v . }  => { ?m solidx:hasAttribute true . } .
{ ?m solidx:isMatcher true . ?m acp:client ?v . } => { ?m solidx:hasAttribute true . } .
{ ?m solidx:isMatcher true . ?m acp:issuer ?v . } => { ?m solidx:hasAttribute true . } .
{ ?m solidx:isMatcher true . ?m acp:vc ?v . }     => { ?m solidx:hasAttribute true . } .

# ── matcher raw values mapped into principal space (drive candidate generation) ───────
{ ?m solidx:isMatcher true . ?m acp:agent ?a . ?a solidx:isWebId true . }
=> { ?m solidx:agentValP ?a . } .
{ ?m acp:agent acp:PublicAgent . }        => { ?m solidx:agentValP auth:Public . } .
{ ?m acp:agent acp:AuthenticatedAgent . } => { ?m solidx:agentValP auth:Authenticated . } .
# [OPUS-4.8] sq-3jtd.5: acp:CreatorAgent / acp:OwnerAgent — the context agent must be the
# resource's CREATOR / OWNER. That fact (<r> solidx:creator|owner <w>) is loader-synthesized
# ONLY from the TRUSTED provenance channel (never pod content — design doc §2.4). It is
# resource-coupled, so it is NOT mapped to a plain agentValP (which would grant the creator
# on EVERY resource the policy reaches); a CreatorAgent matcher is flagged provMatcher, and
# the resource-scoped grant in acp-c.n3 joins it back to the specific (resource, creator).
{ ?m solidx:isMatcher true . ?m acp:agent acp:CreatorAgent . } => { ?m solidx:provMatcher solidx:creator . } .
{ ?m solidx:isMatcher true . ?m acp:agent acp:OwnerAgent . }   => { ?m solidx:provMatcher solidx:owner . } .
{ ?m solidx:isMatcher true . ?m acp:client ?c . ?c log:notEqualTo acp:PublicClient . }
=> { ?m solidx:clientValP ?c . } .
{ ?m acp:client acp:PublicClient . }      => { ?m solidx:clientValP auth:AnyClient . } .
# [OPUS-4.8] sq-3jtd.6: acp:issuer — a concrete OIDC issuer IRI is its own principal value
# (there is no ACP "public issuer" special; an absent acp:issuer means issuer-unconstrained,
# handled by the accept-set top rule below, exactly like an absent acp:client).
{ ?m solidx:isMatcher true . ?m acp:issuer ?i . }
=> { ?m solidx:issuerValP ?i . } .

# ── accept-sets: downward-closed over the principal lattice ────────────────────────────
# [SONNET-4.6] sq-ysv3u: the agent dimension is now computed in TWO steps.
# `solidx:rawAgentP` is the accept-set the `acp:agent` attribute alone yields (these five
# rules are the pre-acp:vc `acceptsAgentP` rules, renamed and otherwise UNCHANGED);
# `solidx:acceptsAgentP` is that set intersected with the `acp:vc` credential constraint
# (the block below). For a matcher with NO `acp:vc` — i.e. every matcher in a pod that does
# not credential-gate — the second step is the identity, so the auth view is byte-identical
# to the pre-acp:vc rule set.
{ ?m solidx:agentValP ?a . } => { ?m solidx:rawAgentP ?a . } .
# A nonempty matcher with no agent attribute is agent-unconstrained.
{ ?m solidx:hasAttribute true . ?UNSCOPED log:notIncludes { ?m acp:agent ?x . } . }
=> { ?m solidx:rawAgentP auth:Public . } .
{ ?m solidx:rawAgentP auth:Public . }
=> { ?m solidx:rawAgentP auth:Authenticated . } .
{ ?m solidx:rawAgentP auth:Authenticated . ?a solidx:isCandAgent true . }
=> { ?m solidx:rawAgentP ?a . } .
# A provenance matcher's own accept-set holds only its non-provenance values: whether it
# accepts a creator or owner depends on the resource, so that lives on the matcher's
# per-resource instance (below), never on the matcher itself.

# ── [SONNET-4.6] sq-ysv3u: acp:vc — the CREDENTIAL constraint on the agent dimension ────
# `?m acp:vc ?c` requires the context agent to HOLD a verified credential satisfying the
# requirement `?c`. ACP attributes are conjunctive ACROSS attributes and disjunctive WITHIN
# one, so a matcher's agent accept-set is (its acp:agent accept-set) ∩ (the holders of ANY
# of its acp:vc requirements) — which is exactly the rawAgentP/acceptsAgentP split above.
#
# `?a solidx:holdsVc ?c` is a TRUSTED, ALREADY-VERIFIED fact: the loader synthesizes it from
# the caller-supplied `VerifiedCredentials` map and from NOWHERE else — never from pod or
# `.acr` content (loader.rs's solidx: reserved-predicate guard drops any forged one). This is
# the "verify outside the reasoner, match inside it" split the design record mandates
# (research/solid-vocab-gaps-design.md §2): no signature is ever checked in the rules.
#
# FAIL-CLOSED BY CONSTRUCTION: with no credential supplied, no `holdsVc` fact exists, so an
# acp:vc matcher's acceptsAgentP is EMPTY — it rejects every candidate in allOf, never
# satisfies anyOf, and never fires as a noneOf exception. (Before this block acp:vc was an
# UNRECOGNIZED attribute, so such a matcher looked agent-unconstrained and accepted
# auth:Public: a credential-gated policy granted EVERYONE, anonymous included.)
{ ?m solidx:rawAgentP ?a . ?UNSCOPED log:notIncludes { ?m acp:vc ?v . } . }
=> { ?m solidx:acceptsAgentP ?a . } .
{ ?m solidx:rawAgentP ?a . ?m acp:vc ?c . ?a solidx:holdsVc ?c . }
=> { ?m solidx:acceptsAgentP ?a . } .

{ ?m solidx:clientValP ?c . } => { ?m solidx:acceptsClientP ?c . } .
{ ?m solidx:hasAttribute true . ?UNSCOPED log:notIncludes { ?m acp:client ?x . } . }
=> { ?m solidx:acceptsClientP auth:AnyClient . } .
{ ?m solidx:acceptsClientP auth:AnyClient . ?c solidx:isCandClient true . }
=> { ?m solidx:acceptsClientP ?c . } .

# [OPUS-4.8] sq-3jtd.6: issuer accept-set, the twin of the client one above.
{ ?m solidx:issuerValP ?i . } => { ?m solidx:acceptsIssuerP ?i . } .
{ ?m solidx:hasAttribute true . ?UNSCOPED log:notIncludes { ?m acp:issuer ?x . } . }
=> { ?m solidx:acceptsIssuerP auth:AnyIssuer . } .
{ ?m solidx:acceptsIssuerP auth:AnyIssuer . ?i solidx:isCandIssuer true . }
=> { ?m solidx:acceptsIssuerP ?i . } .

# ── candidates per policy: its matchers' values + the dimension tops ───────────────────
# (the tops require >=1 allOf/anyOf matcher — encodes ACP's "at least one matcher" rule)
{ ?pol solidx:hasMatcher ?m . ?m solidx:agentValP ?a . }  => { ?pol solidx:candAgent ?a . } .
{ ?pol solidx:hasMatcher ?m . ?m solidx:clientValP ?c . } => { ?pol solidx:candClient ?c . } .
{ ?pol solidx:hasMatcher ?m . ?m solidx:issuerValP ?i . } => { ?pol solidx:candIssuer ?i . } .
# [SONNET-4.6] sq-ysv3u: an acp:vc matcher can only ever accept a CONCRETE holder (the
# lattice tops hold no credential), so each holder of one of its requirements must enter the
# candidate set — exactly as a concrete `acp:agent` WebID does via agentValP above. Without
# this the holder would never be enumerated and the matcher could never grant.
{ ?pol solidx:hasMatcher ?m . ?m acp:vc ?c . ?a solidx:holdsVc ?c . ?a solidx:isWebId true . }
=> { ?pol solidx:candAgent ?a . } .
# A noneOf matcher deliberately generates NO candidates (see the matcher registry above), so
# the rule just above cannot reach it — yet its accept-set must still contain the holders, or
# a credential-gated EXCEPTION would except nobody. Marking the holder isCandAgent directly is
# what the agent-unconstrained accept-set closure needs, and it is grant-neutral: candidate
# TRIPLES are minted from ?pol solidx:candAgent (above), never from isCandAgent alone.
{ ?m solidx:isMatcher true . ?m acp:vc ?c . ?a solidx:holdsVc ?c . ?a solidx:isWebId true . }
=> { ?a solidx:isCandAgent true . } .
{ ?pol solidx:hasMatcher ?m . }
=> { ?pol solidx:candAgent auth:Public . ?pol solidx:candClient auth:AnyClient .
     ?pol solidx:candIssuer auth:AnyIssuer . } .
{ ?pol solidx:candAgent ?a . ?a solidx:isWebId true . }       => { ?a solidx:isCandAgent true . } .
{ ?pol solidx:candClient ?c . ?c log:notEqualTo auth:AnyClient . } => { ?c solidx:isCandClient true . } .
{ ?pol solidx:candIssuer ?i . ?i log:notEqualTo auth:AnyIssuer . } => { ?i solidx:isCandIssuer true . } .

# ── [OPUS-4.8] sq-3jtd.5: provenance (CreatorAgent/OwnerAgent) candidate generation ─────
# A provenance matcher M (kind K) in policy P, applied to resource R whose trusted K-fact
# is W, yields RESOURCE-SCOPED candidates: the agent is the creator/owner W, crossed with
# every client and issuer value P's allOf/anyOf matchers name (so a sibling client/issuer
# matcher of the same policy combines with M). We tag each candidate with its resource R so the
# acp-c.n3 grant fires ONLY on R — W (creator of R1) never reaches R2. The candidate IRI
# embeds the resource alongside the usual (pol, agent, client, issuer), all percent-encoded,
# so distinct (pol, W, client, issuer, R) tuples stay injective.
# ?kind is the creator/owner predicate IRI itself (solidx:creator / solidx:owner), so the
# loader fact `?r ?kind ?w` matches directly with ?kind in predicate position.
#
# A policy using a provenance matcher in any role (allOf, anyOf, noneOf) is RESOURCE-SCOPED:
# whether it applies depends on the resource, so every candidate it has is minted per
# resource (below) and every provenance matcher it uses is evaluated through its instance
# for that resource. The instance (matcher M, resource R) accepts what M accepts on its own
# plus R's creator/owner W (holding one of M's acp:vc requirements, when M has any), so a
# creator of R1 never satisfies M on R2, in any role.
{ ?pol acp:allOf ?m . }  => { ?pol solidx:usesMatcher ?m . } .
{ ?pol acp:anyOf ?m . }  => { ?pol solidx:usesMatcher ?m . } .
{ ?pol acp:noneOf ?m . } => { ?pol solidx:usesMatcher ?m . } .
{ ?pol solidx:usesMatcher ?m . ?m solidx:provMatcher ?kind . }
=> { ?pol solidx:resourceScoped true . } .
{ ?pol solidx:usesMatcher ?m . ?m solidx:provMatcher ?kind . ?pol solidx:appliesToResource ?r .
  ?m log:uri ?ms . ?r log:uri ?rs . ?ms string:encodeForUri ?me . ?rs string:encodeForUri ?re .
  ("urn:sparq:matcher?m=" ?me "&res=" ?re) string:concatenation ?is .
  ?mi log:uri ?is . }
=> { ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r . } .
{ ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r . ?m solidx:provMatcher ?kind .
  ?r ?kind ?w . ?w solidx:isWebId true . }
=> { ?mi solidx:provAgent ?w . ?w solidx:isCandAgent true . } .
{ ?mi solidx:provAgent ?w . ?mi solidx:instanceOf ?m .
  ?UNSCOPED log:notIncludes { ?m acp:vc ?v . } . }
=> { ?mi solidx:acceptsAgentP ?w . } .
{ ?mi solidx:provAgent ?w . ?mi solidx:instanceOf ?m . ?m acp:vc ?c . ?w solidx:holdsVc ?c . }
=> { ?mi solidx:acceptsAgentP ?w . } .
{ ?mi solidx:instanceOf ?m . ?m solidx:acceptsAgentP ?a . }  => { ?mi solidx:acceptsAgentP ?a . } .
{ ?mi solidx:instanceOf ?m . ?m solidx:acceptsClientP ?c . } => { ?mi solidx:acceptsClientP ?c . } .
{ ?mi solidx:instanceOf ?m . ?m solidx:acceptsIssuerP ?i . } => { ?mi solidx:acceptsIssuerP ?i . } .

# ── a resource with NO recorded creator/owner leaves the matcher UNDECIDED ──────────────
# The loader emits `?r solidx:creator|owner ?w` from the trusted AccessProvenance map and
# from NOWHERE else (both predicates sit in the solidx: namespace the loader forbids pod
# content from stating), so the ABSENCE of that fact is exactly "the trusted caller
# supplied no creator (resp. owner) for this resource" — a resource that has an `.acr` but
# is not in the view included. The instance for such a resource neither accepts nor
# rejects an agent, so it is marked provUndecided and every role reads that mark as a
# third truth value: an allow whose condition is undecided does not apply, a deny whose
# condition is undecided does. Strata B/C do that for allOf/anyOf; the session layer does
# it for a noneOf exception, which is why the mark travels into the auth view alongside
# the accept-sets (src/materialize.rs MATCHER_FACTS -> src/authindex.rs).
# Input-only negation: the creator/owner facts are loader input to this stratum.
{ ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r . ?m solidx:provMatcher solidx:creator .
  ?UNSCOPED log:notIncludes { ?r solidx:creator ?w . } . }
=> { ?mi solidx:provUndecided solidx:creator . } .
{ ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r . ?m solidx:provMatcher solidx:owner .
  ?UNSCOPED log:notIncludes { ?r solidx:owner ?w . } . }
=> { ?mi solidx:provUndecided solidx:owner . } .

# mint the per-resource provenance candidate triples. On resource ?r, a resource-scoped
# policy's candidate AGENTS are its policy-wide candAgent set (minted by the
# resource-scoped rule below) PLUS ?r's own creator/owner — the only further agents a
# provenance matcher of the policy can accept there. This rule adds the latter and crosses
# them with EVERY client and issuer value the policy's allOf/anyOf matchers name
# (candClient / candIssuer), so a SIBLING client or issuer matcher of the same policy
# combines with the provenance one instead of naming a (client, issuer) pair that no
# candidate ever carries.
# The creator/owner (?pa, ?r) pair is re-derived COUPLED here (?r ?kind ?pa), and ?r is in
# the key + carried as provForResource, so two resources sharing a creator get distinct
# candidates and distinct resource-scoped grants. The key has the same shape as the
# resource-scoped one below, so the two rules feed ONE candidate set. Components
# percent-encoded -> injective minting.
{ ?pol solidx:resourceScoped true . ?pol solidx:appliesToResource ?r .
  ?pol solidx:usesMatcher ?m . ?m solidx:provMatcher ?kind .
  ?r ?kind ?pa . ?pa solidx:isWebId true .
  ?pol solidx:candClient ?pc . ?pol solidx:candIssuer ?pi .
  ?pol log:uri ?pols . ?pa log:uri ?pas . ?pc log:uri ?pcs . ?pi log:uri ?pis . ?r log:uri ?rs .
  ?pols string:encodeForUri ?pole . ?pas string:encodeForUri ?pae .
  ?pcs string:encodeForUri ?pce . ?pis string:encodeForUri ?pie . ?rs string:encodeForUri ?re .
  ("urn:sparq:scand?pol=" ?pole "&agent=" ?pae "&client=" ?pce "&issuer=" ?pie "&res=" ?re)
      string:concatenation ?ks .
  ?k log:uri ?ks . }
=> { ?pol solidx:candTriple ?k . ?pol solidx:provTriple ?k .
     ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc . ?k solidx:pairIssuer ?pi .
     ?k solidx:provForResource ?r . } .

# ── candidate (agent, client, issuer) triples, minted deterministically ────────────────
# (components percent-encoded — string:encodeForUri — so distinct (pol, agent, client,
#  issuer) tuples can never concatenate to the same candidate key)
# A resource-scoped policy's candidates are minted per resource, tagged like the provenance
# candidates above, and never as policy-wide candidates.
{ ?pol solidx:resourceScoped true . ?pol solidx:appliesToResource ?r .
  ?pol solidx:candAgent ?pa . ?pol solidx:candClient ?pc . ?pol solidx:candIssuer ?pi .
  ?pol log:uri ?pols . ?pa log:uri ?pas . ?pc log:uri ?pcs . ?pi log:uri ?pis . ?r log:uri ?rs .
  ?pols string:encodeForUri ?pole . ?pas string:encodeForUri ?pae .
  ?pcs string:encodeForUri ?pce . ?pis string:encodeForUri ?pie . ?rs string:encodeForUri ?re .
  ("urn:sparq:scand?pol=" ?pole "&agent=" ?pae "&client=" ?pce "&issuer=" ?pie "&res=" ?re)
      string:concatenation ?ks .
  ?k log:uri ?ks . }
=> { ?pol solidx:candTriple ?k . ?pol solidx:provTriple ?k .
     ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc . ?k solidx:pairIssuer ?pi .
     ?k solidx:provForResource ?r . } .
{ ?pol solidx:candAgent ?pa . ?pol solidx:candClient ?pc . ?pol solidx:candIssuer ?pi .
  ?UNSCOPED log:notIncludes { ?pol solidx:resourceScoped true . } .
  ?pol log:uri ?pols . ?pa log:uri ?pas . ?pc log:uri ?pcs . ?pi log:uri ?pis .
  ?pols string:encodeForUri ?pole . ?pas string:encodeForUri ?pae .
  ?pcs string:encodeForUri ?pce . ?pis string:encodeForUri ?pie .
  ("urn:sparq:cand?pol=" ?pole "&agent=" ?pae "&client=" ?pce "&issuer=" ?pie)
      string:concatenation ?ks .
  ?k log:uri ?ks . }
=> { ?pol solidx:candTriple ?k .
     ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc . ?k solidx:pairIssuer ?pi . } .
