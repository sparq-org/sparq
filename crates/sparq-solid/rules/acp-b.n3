# ACP — STRATUM B: negation-as-failure over stratum A's (now complete) accept-sets.
# Derives per-candidate-triple allOf rejections and anyOf satisfaction (ACP §"Policies":
# allOf = every matcher satisfied, anyOf = at least one). Runs as its own reason_n3
# call seeded with stratum A's closure (design doc §3.5).
#
# Inputs: stratum A's closure (candTriple/pairAgent/pairClient/pairIssuer,
# acceptsAgentP/ClientP/IssuerP) + the original acp:allOf/anyOf facts. Outputs (stratum
# C's inputs): ?k solidx:allOfRejected true ; ?k solidx:anyOfSat true ; and, for a
# provenance matcher the resource has no recorded creator/owner for, the third truth value
# ?k solidx:allOfUndecided true / ?k solidx:anyOfUndecided true .
#
# [OPUS-4.8] sq-3jtd.6: the issuer dimension is the exact twin of the client dimension.

@prefix acp:    <http://www.w3.org/ns/solid/acp#> .
@prefix solidx: <https://sparq.dev/ns/solidx#> .
@prefix log:    <http://www.w3.org/2000/10/swap/log#> .

# an allOf matcher that does not accept the triple's agent (resp. client, issuer) dimension
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?pol acp:allOf ?m .
  ?UNSCOPED log:notIncludes { ?m solidx:provMatcher ?kind . } .
  ?UNSCOPED log:notIncludes { ?m solidx:acceptsAgentP ?pa . } . }
=> { ?k solidx:allOfRejected true . } .
# A provenance matcher is evaluated through its instance for the candidate's resource —
# UNLESS that instance is undecided (the resource has no recorded creator/owner of the
# matcher's kind, acp-a.n3), in which case the matcher neither accepts nor rejects and the
# candidate is marked undecided instead, by the rule below.
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?pol acp:allOf ?m .
  ?m solidx:provMatcher ?kind . ?k solidx:provForResource ?r .
  ?UNSCOPED log:notIncludes { ?mu solidx:instanceOf ?m . ?mu solidx:instanceRes ?r .
                              ?mu solidx:provUndecided ?kind . } .
  ?UNSCOPED log:notIncludes { ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r .
                              ?mi solidx:acceptsAgentP ?pa . } . }
=> { ?k solidx:allOfRejected true . } .

# ── UNDECIDED conjuncts / disjuncts: the third truth value ─────────────────────────────
# An allOf provenance matcher whose instance is undecided for the candidate's resource, and
# whose own client/issuer constraints DO accept the candidate (otherwise the matcher is
# plainly unsatisfied and the dimension rules below reject it), leaves the conjunction
# undecided rather than false. Stratum C withholds the ALLOW and keeps the DENY.
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc .
  ?k solidx:pairIssuer ?pi . ?k solidx:provForResource ?r .
  ?pol acp:allOf ?m . ?m solidx:provMatcher ?kind .
  ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r . ?mi solidx:provUndecided ?kind .
  ?mi solidx:acceptsClientP ?pc . ?mi solidx:acceptsIssuerP ?pi .
  ?UNSCOPED log:notIncludes { ?mj solidx:instanceOf ?m . ?mj solidx:instanceRes ?r .
                              ?mj solidx:acceptsAgentP ?pa . } . }
=> { ?k solidx:allOfUndecided true . } .
# The anyOf twin: an undecided disjunct leaves the disjunction undecided — unless some
# other anyOf matcher is outright satisfied, which stratum C checks via `anyOfSat`, so it
# is not re-checked here.
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc .
  ?k solidx:pairIssuer ?pi . ?k solidx:provForResource ?r .
  ?pol acp:anyOf ?m . ?m solidx:provMatcher ?kind .
  ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r . ?mi solidx:provUndecided ?kind .
  ?mi solidx:acceptsClientP ?pc . ?mi solidx:acceptsIssuerP ?pi .
  ?UNSCOPED log:notIncludes { ?mj solidx:instanceOf ?m . ?mj solidx:instanceRes ?r .
                              ?mj solidx:acceptsAgentP ?pa . } . }
=> { ?k solidx:anyOfUndecided true . } .

# [OPUS-4.8] sq-az1b: DEFENCE IN DEPTH. A PROVENANCE (CreatorAgent/OwnerAgent) allOf
# matcher's agent constraint is intrinsically resource-COUPLED — it accepts an agent only AS
# the creator/owner of a SPECIFIC resource — so it may only ever clear a candidate that
# names the resource it was decided against. Every candidate of a policy that USES a
# provenance matcher is now resource-scoped and provTriple-tagged (acp-a.n3), so this rule
# fires on nothing today; it is kept so that a candidate source which forgot the resource tag
# could not reach a provenance policy's grant rules, and so a sibling concrete-WebID
# `acp:agent` matcher naming the same creator/owner WebID can never introduce a
# resource-unbound candidate that the agent-dimension rule above would not reject.
{ ?pol solidx:candTriple ?k . ?pol acp:allOf ?m . ?m solidx:provMatcher ?kind .
  ?UNSCOPED log:notIncludes { ?pol solidx:provTriple ?k . } . }
=> { ?k solidx:allOfRejected true . } .
{ ?pol solidx:candTriple ?k . ?k solidx:pairClient ?pc . ?pol acp:allOf ?m .
  ?UNSCOPED log:notIncludes { ?m solidx:acceptsClientP ?pc . } . }
=> { ?k solidx:allOfRejected true . } .
{ ?pol solidx:candTriple ?k . ?k solidx:pairIssuer ?pi . ?pol acp:allOf ?m .
  ?UNSCOPED log:notIncludes { ?m solidx:acceptsIssuerP ?pi . } . }
=> { ?k solidx:allOfRejected true . } .

# at least one anyOf matcher accepts all three dimensions
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc .
  ?k solidx:pairIssuer ?pi .
  ?pol acp:anyOf ?m . ?m solidx:acceptsAgentP ?pa . ?m solidx:acceptsClientP ?pc .
  ?m solidx:acceptsIssuerP ?pi . }
=> { ?k solidx:anyOfSat true . } .
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc .
  ?k solidx:pairIssuer ?pi . ?k solidx:provForResource ?r .
  ?pol acp:anyOf ?m . ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r .
  ?mi solidx:acceptsAgentP ?pa . ?mi solidx:acceptsClientP ?pc . ?mi solidx:acceptsIssuerP ?pi . }
=> { ?k solidx:anyOfSat true . } .
