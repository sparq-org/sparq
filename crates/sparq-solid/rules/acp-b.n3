# ACP — STRATUM B: negation-as-failure over stratum A's (now complete) accept-sets.
# Derives per-candidate-triple allOf rejections and anyOf satisfaction (ACP §"Policies":
# allOf = every matcher satisfied, anyOf = at least one). Runs as its own reason_n3
# call seeded with stratum A's closure (design doc §3.5).
#
# Inputs: stratum A's closure (candTriple/pairAgent/pairClient/pairIssuer,
# acceptsAgentP/ClientP/IssuerP) + the original acp:allOf/anyOf facts. Outputs (stratum
# C's inputs): ?k solidx:allOfRejected true ; ?k solidx:anyOfSat true .
#
# [OPUS-4.8] sq-3jtd.6: the issuer dimension is the exact twin of the client dimension.

@prefix acp:    <http://www.w3.org/ns/solid/acp#> .
@prefix solidx: <https://sparq.dev/ns/solidx#> .
@prefix log:    <http://www.w3.org/2000/10/swap/log#> .

# an allOf matcher that does not accept the triple's agent (resp. client, issuer) dimension
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?pol acp:allOf ?m .
  ?UNSCOPED log:notIncludes { ?m solidx:provMatcher ?kind . } .
  ?UNSCOPED log:notIncludes { ?m solidx:acceptsAgentP ?pa . } . }
=> { ?k solidx:allOfRejected true . } .
# A provenance matcher is evaluated through its instance for the candidate's resource.
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?pol acp:allOf ?m .
  ?m solidx:provMatcher ?kind . ?k solidx:provForResource ?r .
  ?UNSCOPED log:notIncludes { ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r .
                              ?mi solidx:acceptsAgentP ?pa . } . }
=> { ?k solidx:allOfRejected true . } .

# [OPUS-4.8] sq-az1b: a PROVENANCE (CreatorAgent/OwnerAgent) allOf matcher's agent
# constraint is intrinsically resource-COUPLED — it accepts an agent only AS the creator/
# owner of a SPECIFIC resource. Its `acceptsAgentP` accept-set fact (acp-a.n3) is agent-only
# and resource-UNBOUND (it has to be, to clear the matcher's own resource-scoped provenance
# candidate in the agent dimension). So if a SIBLING concrete-WebID `acp:agent` matcher under
# the same allOf independently introduces that same creator/owner WebID as a REGULAR
# (non-resource-scoped) candidate, the agent-dimension rule above would NOT reject it on
# resources where the agent is NOT the creator/owner — an over-grant. A provenance allOf
# matcher therefore rejects every candidate of its policy that is NOT a resource-scoped
# provenance candidate (provTriple); the matcher's OWN provenance candidate is handled by the
# resource-scoped grant in acp-c.n3 (and a sibling provenance matcher's candidate, if its
# agent differs, is still rejected by the agent-dimension rule above).
{ ?pol solidx:candTriple ?k . ?pol acp:allOf ?m . ?m solidx:provMatcher ?kind .
  ?UNSCOPED log:notIncludes { ?pol solidx:provTriple ?k . } . }
=> { ?k solidx:allOfRejected true . } .
{ ?pol solidx:candTriple ?k . ?k solidx:pairClient ?pc . ?pol acp:allOf ?m .
  ?UNSCOPED log:notIncludes { ?m solidx:acceptsClientP ?pc . } . }
=> { ?k solidx:allOfRejected true . } .
{ ?pol solidx:candTriple ?k . ?k solidx:pairIssuer ?pi . ?pol acp:allOf ?m .
  ?UNSCOPED log:notIncludes { ?m solidx:acceptsIssuerP ?pi . } . }
=> { ?k solidx:allOfRejected true . } .

# at least one anyOf matcher accepts all three dimensions
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc .
  ?k solidx:pairIssuer ?pi .
  ?pol acp:anyOf ?m . ?m solidx:acceptsAgentP ?pa . ?m solidx:acceptsClientP ?pc .
  ?m solidx:acceptsIssuerP ?pi . }
=> { ?k solidx:anyOfSat true . } .
{ ?pol solidx:candTriple ?k . ?k solidx:pairAgent ?pa . ?k solidx:pairClient ?pc .
  ?k solidx:pairIssuer ?pi . ?k solidx:provForResource ?r .
  ?pol acp:anyOf ?m . ?mi solidx:instanceOf ?m . ?mi solidx:instanceRes ?r .
  ?mi solidx:acceptsAgentP ?pa . ?mi solidx:acceptsClientP ?pc . ?mi solidx:acceptsIssuerP ?pi . }
=> { ?k solidx:anyOfSat true . } .
