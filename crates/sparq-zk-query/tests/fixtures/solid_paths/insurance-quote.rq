# Draft query derived from the Solid App Suite catalogue; consumer confirmation pending.
PREFIX ex:  <https://example.org/solid-suite#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX zkv: <urn:sparq:zk:verified-issuer-placeholder#>   # lane E defines the real predicate
ASK {
  ?lic zkv:verifiedIssuer <urn:fictional:insurance-quote:licensing> .
  ?reg zkv:verifiedIssuer <urn:fictional:insurance-quote:claims-register> .
  GRAPH ?lic {
    ?driver ex:dateOfBirth ?dob ;
            ex:method ex:recorded-by-authority .
    FILTER (?dob <= "2001-11-13"^^xsd:date)          # 25 or older on 2026-11-13
  }
  GRAPH ?reg {
    ?driver ex:claimsPeriodStart ?start ;
            ex:claimsPeriodEnd   ?end ;
            ex:claimsComplete    true ;
            ex:method ex:recorded-by-authority .
    FILTER (?start <= "2021-11-13"^^xsd:date && ?end >= "2026-11-13"^^xsd:date)
  }
  FILTER NOT EXISTS {
    GRAPH ?reg {
      ?claim ex:claimant ?driver ;
             ex:claimDate ?cd .
      FILTER (?cd >= "2021-11-13"^^xsd:date)
    }
  }
}
