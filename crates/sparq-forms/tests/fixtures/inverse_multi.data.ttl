# SCOPE: two-file rule. A content change here moves fixtures/inverse_multi.golden.json;
# regenerate it in the same change with
# `UPDATE_GOLDENS=1 cargo test -p sparq-forms --test golden` and review the diff.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/> .

ex:apollo a ex:Project ;
  ex:title "Apollo" ;
  ex:budget "1000000"^^xsd:integer ;
  ex:homepage <http://example.org/apollo/logo.svg> .

ex:neil a ex:Person ; ex:worksOn ex:apollo .
ex:buzz a ex:Person ; ex:worksOn ex:apollo .
