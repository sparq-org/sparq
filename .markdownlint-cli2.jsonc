// markdownlint-cli2 config — HARD documentation-quality gate (bead sq-5fd1). [OPUS-4.8]
//
// SCOPE: this HARD gate covers the user-facing + governance doc surface — the
// top-level governance docs, the `skills/` usage tree (the source of truth for using
// sparq), `docs/`, every crate README/doc, the `book/` mdBook sources (issue #5020),
// AND (as of sq-rqyo) the `research/` design records + the `zk/` research scaffolds,
// whose ~97-violation cosmetic backlog (mostly missing code-fence languages) has been
// cleared. The only carve-out is third-party `vendor/` trees (any `**/vendor` subtree)
// and the vendored ontologies, kept in `ignores` below. `bench/` markdown is still out
// of HARD scope and is checked ADVISORY-only (whole-repo) so any new backlog there
// stays visible.
//
// RULESET: markdownlint defaults, MINUS the rules that fight this repo's deliberate
// house style (long unwrapped lines, bare/autolink URLs, inline HTML for the logo +
// metadata comments, CHANGELOG-style repeated/duplicate headings) and MINUS the
// purely-cosmetic "blank line around X" rules that are render-irrelevant here. What
// remains catches REAL defects: broken link fragments, mismatched table columns,
// missing space after `#`, stray spaces in code/emphasis, trailing whitespace, and
// missing/duplicate trailing newlines.
{
  "config": {
    "default": true,

    // --- disabled: deliberate house style (see README/AGENTS prose) ---
    "MD013": false, // line-length: docs are intentionally not hard-wrapped at 80
    "MD033": false, // inline HTML: logo SVG, <details>, metadata comments
    "MD034": false, // bare URLs: <https://…> autolinks used throughout
    "MD041": false, // first-line-heading: CHANGELOG / front-matter docs
    "MD025": false, // single H1: CHANGELOG-style multi-section docs
    "MD024": { "siblings_only": true }, // dup headings OK across sections (changelog)
    "MD036": false, // emphasis-as-heading: used as soft sub-labels
    "MD026": false, // trailing punctuation in headings ("… exposing it")
    "MD029": false, // ordered-list numbering style varies by doc
    "MD004": false, // unordered-list bullet style varies by doc
    "MD049": false, // emphasis style (_ vs *) mixed deliberately
    "MD007": false, // list indent width varies
    "MD046": false, // code-block style (indented vs fenced) mixed

    // --- disabled: purely cosmetic blank-line spacing (render-irrelevant here) ---
    "MD022": false, // blanks around headings
    "MD031": false, // blanks around fenced code
    "MD032": false  // blanks around lists
  },
  // HARD-gate scope: governance docs + skills/ + docs/ + crates/ + research/ + zk/ + book/.
  "globs": [
    "*.md",
    "skills/**/*.md",
    "docs/**/*.md",
    "crates/**/*.md",
    "research/**/*.md",
    "zk/**/*.md",
    // [OPUS-5] issue #5020: the mdBook sources. They were outside this HARD glob AND
    // outside the lychee internal-links file list, while the terminology gate's
    // `docs-markdown` surface already covered book/ — an accidental hole, not a
    // carve-out, so a structural defect authored in book/src/ was caught by neither.
    // The pages' mdBook `{{#include}}` / `{{#rustdoc_include}}` directives are inert
    // here: markdownlint sees them as ordinary text (the `{{#rustdoc_include}}` one
    // sits inside a fenced block), so no rule exemption is needed.
    "book/**/*.md",
    // [OPUS-4.8] sq-lhwo.1: the metrics-harness README, in the HARD markdownlint
    // (structural) glob. [OPUS-5] sq-jyhr8: the lychee deferral once noted here is
    // DISCHARGED — research/agent-effectiveness-program.md +
    // research/dogfooding-sparq-knowledge-graph.md (PRs #1064/#1063) are on main, so
    // metrics/**/*.md and scripts/agent-telemetry/**/*.md are now in the HARD lychee
    // internal-links scope too (see docs-quality.yml).
    "metrics/**/*.md"
  ],
  "ignores": [
    "node_modules",
    "**/node_modules",
    "target",
    "**/target",
    "vendor",
    "**/vendor",
    // [OPUS-4.8] sq-5reoy: the explicit "zk/xpath/vendor" ignore was dropped — the
    // zk/xpath tree moved to the sparq-org/noir_XPath face repo (#1599); "**/vendor"
    // still covers any remaining vendored subtree.
    // Vendored third-party ontologies (sparql-zkp-ontologies, ISWC 2025;
    // MIT-licensed as of 2026-06-21, see the directory LICENSE + PROVENANCE.md).
    // Reproduced verbatim and not reformatted; treat the whole vendored tree as
    // third-party (same rationale as vendor/). [OPUS-4.8]
    "crates/sparq-trust/ontologies/zkp-sparql"
  ]
}
