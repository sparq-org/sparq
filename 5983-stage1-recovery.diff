+#[test]
+fn unique_priorities_small() {
+    // Deliberately unsorted insertion order.
+    let tasks: Vec<(i64, i64)> = vec![(0, 5), (1, 20), (2, 1), (3, 15), (4, 9), (5, 30), (6, 0)];
+    check(&tasks, &[1, 2, 3, 7, 100]);
+}
