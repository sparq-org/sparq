+    let n = 2500;
+    let tasks: Vec<(i64, i64)> = (0..n)
+        .map(|i| (i as i64, ((i as i64) * 2654435761i64) % (n as i64 * 3)))
+        .collect();
+    check(&tasks, &[1, 1000, 1023, 1024, 1025, 2000, 2500, 3000]);
