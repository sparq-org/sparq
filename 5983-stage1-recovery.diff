+#[test]
+fn unique_priorities_pseudo_random_medium() {
+    let n = 300;
+    let tasks: Vec<(i64, i64)> = (0..n)
+        .map(|i| (i as i64, ((i as i64) * 2654435761i64) % (n as i64 * 7)))
+        .collect();
+    check(&tasks, &[1, 5, 50, 299, 300, 400]);
+}
