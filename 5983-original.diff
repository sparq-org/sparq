diff --git a/crates/sparq-serve/src/applier.rs b/crates/sparq-serve/src/applier.rs
index 8daad4548..22e9896e6 100644
--- a/crates/sparq-serve/src/applier.rs
+++ b/crates/sparq-serve/src/applier.rs
@@ -129,3 +129,95 @@ impl ApplyUpdates for GraphApplier {
         Footprint::of_sparql(update)
     }
 }
