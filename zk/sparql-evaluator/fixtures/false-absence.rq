# [GPT-6] No branch has a solution in the committed default.nt graph.
# A variable endpoint of a zero-length path ranges over subjects and objects,
# even when VALUES binds it to a predicate-only IRI or an absent IRI.
# SUBSTR positions include only position one for start zero and length two.
PREFIX ex: <http://ex/>
ASK {
  { ?s ex:score ?v FILTER(?v > 100) }
  UNION
  { VALUES ?s { ex:value ex:missing } ?s ex:value* ?o }
  UNION
  { VALUES ?s { ex:alice }
    { ?s ex:value ?v MINUS { ?s ex:value ?other } }
  }
  UNION
  { BIND(SUBSTR("abc", 0, 2) AS ?slice) FILTER(?slice != "a") }
}
