# [GPT-6] No branch has a solution in the committed default.nt graph.
# A variable endpoint of a zero-length path ranges over subjects and objects,
# even when VALUES binds it to a predicate-only IRI or an absent IRI.
# SUBSTR positions include only position one for start zero and length two.
# Invalid integer subtype facets remain expression errors through arithmetic.
# Substituted ?s disappears from both inner MINUS domains, making EXISTS true.
PREFIX ex: <http://ex/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  { ?s ex:score ?v FILTER(?v > 100) }
  UNION
  { VALUES ?s { ex:value ex:missing } ?s ex:value* ?o }
  UNION
  { VALUES ?s { ex:alice }
    { ?s ex:value ?v MINUS { ?s ex:value ?other } }
  }
  UNION
  { BIND(SUBSTR("abc", 0, 2) AS ?slice) FILTER(?slice != "a") }
  UNION
  { BIND(("1200"^^xsd:byte + 0) > 5 AS ?invalid) FILTER(?invalid) }
  UNION
  {
    FILTER("2024-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>
      = "2024-01-01T00:00:00.000000001Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>)
  }
  UNION
  { VALUES ?s { ex:alice }
    FILTER NOT EXISTS { ?s ex:value ?m MINUS { ?s ex:value ?z } }
  }
}
